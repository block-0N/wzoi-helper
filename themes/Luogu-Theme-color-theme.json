{
    "$schema": "vscode://schemas/color-theme",
    "name": "Luogu Theme",
    "type": "light",
    "colors": {
        "editor.background": "#FFFFFF",
        "editor.foreground": "#000000",
        "editorLineNumber.foreground": "#999999",
        "editorLineNumber.activeForeground": "#333333",
        "editor.lineHighlightBackground": "#F5F5F5",
        "editor.selectionBackground": "#ADD6FF",
        "editorCursor.foreground": "#000000",
        "editorBracketHighlight.foreground1": "#6F42C1",
        "editorBracketHighlight.foreground2": "#D97706",
        "editorBracketHighlight.foreground3": "#007F73",
        "editorBracketHighlight.foreground4": "#BE185D",
        "editorBracketHighlight.foreground5": "#647A1E",
        "editorBracketHighlight.foreground6": "#3F5F91",
        "editorBracketHighlight.unexpectedBracket.foreground": "#C92C2C",
        "sideBar.background": "#ECECEC",
        "sideBar.foreground": "#000000",
        "sideBar.border": "#D0D0D0",
        "sideBarTitle.foreground": "#000000",
        "sideBarSectionHeader.background": "#E0E0E0",
        "sideBarSectionHeader.foreground": "#000000",
        "activityBar.background": "#E0E0E0",
        "activityBar.foreground": "#000000",
        "activityBar.inactiveForeground": "#707070"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#a0a1a7",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Strings and Characters",
            "scope": [
                "string",
                "constant.other.symbol",
                "constant.character"
            ],
            "settings": {
                "foreground": "#50a14f"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#b76b01"
            }
        },
        {
            "name": "Keywords and Storage Types",
            "scope": [
                "keyword",
                "storage.type",
                "keyword.control"
            ],
            "settings": {
                "foreground": "#a626a4"
            }
        },
        {
            "name": "Language Constants (e.g., INT_MAX)",
            "scope": [
                "constant.language",
                "support.constant"
            ],
            "settings": {
                "foreground": "#b76b01"
            }
        },
        {
            "name": "Preprocessor Directives (#include)",
            "scope": [
                "keyword.control.directive",
                "keyword.control.preprocessor"
            ],
            "settings": {
                "foreground": "#c92c2c"
            }
        },
        {
            "name": "Macro Directives (#define)",
            "scope": [
                "keyword.control.directive.define",
                "meta.preprocessor"
            ],
            "settings": {
                "foreground": "#e45649"
            }
        },
        {
            "name": "Types and Classes",
            "scope": [
                "entity.name.type",
                "support.type",
                "support.class"
            ],
            "settings": {
                "foreground": "#2B91AF"
            }
        },
        {
            "name": "Functions and Methods",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call"
            ],
            "settings": {
                "foreground": "#4078f2"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.other",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#000000"
            }
        },
        {
            "name": "Macro Names",
            "scope": [
                "entity.name.function.preprocessor",
                "variable.other.macro"
            ],
            "settings": {
                "foreground": "#e45649"
            }
        },
        {
            "name": "Punctuation and Operators",
            "scope": [
                "punctuation",
                "meta.brace",
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#383a42"
            }
        }
    ]
}
